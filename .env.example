# Copy to .env. NEVER commit real credentials.
PORT=3000
NODE_ENV=development
# Local embedded database: no database server, pgAdmin, Docker or password needed.
DB_DRIVER=pglite
PGLITE_DATA_DIR=./.local-db
# For an external PostgreSQL server instead, use DB_DRIVER=postgres and set DATABASE_URL.
DATABASE_URL=
DATABASE_SSL=false
# Only for explicitly trusted test systems with self-signed certs; prefer certificate verification
DATABASE_SSL_INSECURE=false
# Used only for seed:admin, choose a unique strong password:
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Store Owner
# Optional WooCommerce connection, HTTPS website, keys stored ONLY server-side
WC_URL=https://your-shop.example.com
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
# Only enable POS -> WooCommerce order posting after testing on a staging store
WC_PUSH_POS=false
# Admin-triggered order sync by default. Optional webhook secret for push events
WC_WEBHOOK_SECRET=
# Allowed app origin for browser requests. Optional in same-origin setup.
APP_ORIGIN=http://localhost:3000

# Optional secure password reset emails (requires verified sender/domain)
RESEND_API_KEY=
MAIL_FROM=Pet Store ERP <noreply@your-domain.com>
