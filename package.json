{
  "name": "petstore-erp",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-portal pet store ERP: Admin, Shop POS, Warehouse and WooCommerce",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
